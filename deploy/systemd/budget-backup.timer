[Unit]
Description=Codzienna kopia zapasowa bazy aplikacji budzetowej

[Timer]
# Serwer chodzi na UTC. 02:00 UTC to pol godziny przed odtworzeniem konta demo
# (budget-demo-reset.timer, 02:30) — kolejnosc jest zamierzona: kopia powstaje
# ZANIM nocne zadanie zacznie kasowac i przebudowywac dane demo.
OnCalendar=*-*-* 02:00:00
# Nadrabia uruchomienie, jesli serwer byl wylaczony o wyznaczonej porze.
Persistent=true

[Install]
WantedBy=timers.target

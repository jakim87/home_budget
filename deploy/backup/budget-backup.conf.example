# Wzor konfiguracji kopii zapasowych. Skopiuj do /etc/budget-backup.conf
# i ustaw prawa: chown postgres:postgres, chmod 600 (plik wskazuje na haslo
# szyfrowania). Wlascicielem MUSI byc postgres, nie root — budget-backup.service
# uruchamia skrypt jako User=postgres, wiec przy root:root 600 konfiguracja
# bylaby nieczytelna i skrypt przewrocilby sie na "BACKUP_DB nie ustawione".

# Nazwa bazy do zrzucenia.
BACKUP_DB=budget_db

# Katalog na kopie NA TYM serwerze.
BACKUP_DIR=/var/backups/budget

# Plik zawierajacy haslo szyfrowania (jedna linia, chmod 600).
# UWAGA: bez tego hasla nie odtworzysz zadnej kopii. Trzymaj je rowniez
# POZA serwerem — w menedzerze hasel albo na kartce w domu. Haslo, ktore
# istnieje wylacznie na maszynie, ktora wlasnie padla, nie istnieje.
BACKUP_PASSPHRASE_FILE=/etc/budget-backup.passphrase

# Ile najnowszych kopii zostawic (starsze sa kasowane po udanym przebiegu).
BACKUP_KEEP=14

# Katalog na kopie POZA tym serwerem: zamontowany dysk sieciowy, pendrive.
# Puste = wylaczone.
BACKUP_MIRROR_DIR=

# Zdalny storage przez rclone: nazwa_remote:nazwa_bucketa.
# Przyklad dla OVH Object Storage: BACKUP_RCLONE_REMOTE=ovh:budget-backups
# Przyklad dla Backblaze B2:       BACKUP_RCLONE_REMOTE=b2:budget-backups
# Puste = wylaczone.
#
# Konfiguracja rclone: /root/.config/rclone/rclone.conf (lub sudo -u postgres).
# Dopoki to jest puste, kopie leza wylacznie na tej samej maszynie co baza.
BACKUP_RCLONE_REMOTE=
